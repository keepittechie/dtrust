{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dtrust Tier-2 Report",
  "type": "object",
  "required": [
    "schema_version",
    "tier",
    "timestamp_utc",
    "target_rootfs",
    "kernel",
    "distro",
    "users",
    "groups",
    "cron",
    "suid_sgid",
    "services",
    "limits",
    "repos",
    "unsigned_packages",
    "path_shadowing",
    "manual_areas"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "tier": {
      "type": "integer",
      "const": 2
    },
    "timestamp_utc": {
      "type": "string"
    },
    "target_rootfs": {
      "type": "string"
    },
    "kernel": {
      "type": [
        "string",
        "null"
      ]
    },
    "distro": {
      "type": "object"
    },
    "users": {
      "type": "array"
    },
    "groups": {
      "type": "array"
    },
    "cron": {
      "type": "object"
    },
    "suid_sgid": {
      "type": "array"
    },
    "services": {
      "type": "array"
    },
    "limits": {
      "type": "object"
    },
    "repos": {
      "type": "object",
      "properties": {
        "apt": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "yum_dnf": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "pacman": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "unsigned_packages": {
      "type": "array"
    },
    "path_shadowing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "basename",
          "first_hit",
          "shadowed"
        ],
        "properties": {
          "basename": {
            "type": "string"
          },
          "first_hit": {
            "type": "string"
          },
          "shadowed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "manual_areas": {
      "type": "object"
    }
  }
}
